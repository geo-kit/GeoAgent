# Copy to .env and fill in what you use. GeoView reads this file when it starts
# the agent and passes the values to the agent process only.

# Which model to run, as "provider:model". GeoView overrides this with
# --agent-provider / --agent-model when it launches the agent.
GEOAGENT_MODEL=openai:gpt-5-mini

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# LM Studio (OpenAI-compatible local server)
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_MODEL=

# Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Directory GeoView watches for artifacts. GeoView sets this automatically;
# set it by hand only when running the agent standalone.
# GEOVIEW_RESULT_DIR=

# Optional allow-list of directories the agent may browse and load models from
# (os.pathsep separated). Unset means any readable directory.
# GEOAGENT_MODEL_ROOTS=
